---
// Portfolio.astro — Landing preview (primeros 6 proyectos)
import { Image, getImage } from 'astro:assets';
import { getProjects, normalizeAssetPath } from '../utils/data';

const FEATURED_COUNT = 4;
const formatViews = (v: number) => v >= 1000 ? (v / 1000).toFixed(1).replace('.0', '') + 'K' : (v || 0).toString();


// Load content
const rawProjects = await getProjects();
const portfolioAssets = import.meta.glob<{ default: any }>('../assets/portfolio/**/*.{svg,png,jpg,jpeg,webp,gif,mp4,webm,SVG,PNG,JPG,JPEG,WEBP,GIF,MP4,WEBM}', { eager: true });

// Process projects — isWide SIEMPRE auto-detectado por dimensiones reales
const processedProjects = await Promise.all(rawProjects.map(async (p, i) => {
  const isRemoteMain = p.image && p.image.startsWith('http');
  let asset = null;
  let mainOptimizedSrc = p.image || '';

  if (p.image && !isRemoteMain) {
    const normPath = normalizeAssetPath(p.image);
    const assetKey = Object.keys(portfolioAssets).find(k => k.toLowerCase() === normPath.toLowerCase());
    asset = assetKey ? portfolioAssets[assetKey].default : null;

    if (asset) {
      const optimizedMain = await getImage({ src: asset, format: 'webp', width: 1600, quality: 80 });
      mainOptimizedSrc = optimizedMain.src;
    }
  }

  // Gallery images
  const galleryUrls = (p.gallery || []).map((imgPath: string) => {
    if (!imgPath) return null;
    if (imgPath.startsWith('http')) return imgPath;
    const nPath = normalizeAssetPath(imgPath);
    const key = Object.keys(portfolioAssets).find(k => k.toLowerCase() === nPath.toLowerCase());
    return key ? portfolioAssets[key].default.src : null;
  }).filter(Boolean);

  // ── Auto-detectar si la imagen es landscape o portrait ──
  // Nunca se usa el campo is_wide de la base de datos.
  let isWide = false;
  if (asset && typeof asset === 'object' && asset.width && asset.height) {
    isWide = (asset.width / asset.height) > 1.25;
  }
  // Para imágenes remotas: sin acceso a dimensiones, patrón por posición
  // El patrón: 0→normal, 1→normal, 2→wide, 3→normal, 4→normal, 5→wide, …
  // Da exactamente 12 columnas por fila en el grid de 12 cols (4+4+8, 4+4+8)
  else if (isRemoteMain) {
    isWide = (i % 3) === 2;
  }

  return {
    ...p,
    title:    p.title    || 'Proyecto Sin Nombre',
    location: p.location || '',
    color:    p.color    || '#1C2B3A',
    category: (p as any).category || '',
    image:    asset || p.image,
    isWide,
    mediaSrc: mainOptimizedSrc,
    gallery:  [mainOptimizedSrc, ...galleryUrls].filter((v: any, i: number, a: any[]) => v && a.indexOf(v) === i),
  };
}));

const featuredProjects = processedProjects.slice(0, FEATURED_COUNT);
const totalProjects = processedProjects.length;
const hasMore = totalProjects > FEATURED_COUNT;
---

<section id="portfolio" class="py-20 md:py-32 bg-[#F5EFEB] selection:bg-[#2F4156] selection:text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">

    <!-- ── HEADER ── -->
    <div class="flex flex-col md:flex-row items-center md:items-end justify-between gap-12 mb-16 md:mb-20 text-center md:text-left">
      <div>
        <div class="reveal inline-flex items-center gap-3 mb-5">
          <div class="w-10 h-px bg-[#567C8D]"></div>
          <span class="text-[11px] font-black text-[#567C8D] tracking-[0.3em] uppercase">Visual Storytelling</span>
        </div>
        <h2 class="font-display text-5xl lg:text-7xl font-bold text-[#1C2B3A] leading-[1.05]">
          Portafolio de <br class="hidden lg:block"/><em class="text-[#567C8D] not-italic">Propiedades</em>
        </h2>
      </div>
    </div>

    <!-- ── GRID: 3 columnas iguales, altura fija ── -->
    <!-- Diseño simple y robusto: nunca habrá huecos ni que ajustar nada. -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-7">
      {featuredProjects.map((p, i) => (
        <div
          data-id={p.id}
          data-gallery={JSON.stringify(p.gallery)}
          data-title={p.title}
          data-youtube={p.youtubeUrl || ''}
          role="button"
          aria-label={`Ver galería de ${p.title}`}
          tabindex="0"
          class={`reveal portfolio-item group relative rounded-[36px] lg:rounded-[48px] overflow-hidden cursor-pointer shadow-md hover:shadow-2xl transition-all duration-700
                  h-full min-h-[350px] lg:min-h-[450px]
                  ${(i === 0 || i === 3) ? 'md:col-span-2' : 'md:col-span-1'}`}
          style={`background-color: ${p.color}`}
        >
          <!-- Imagen -->
          <div class={`absolute inset-0 w-full h-full overflow-hidden ${!p.image ? 'skeleton' : ''}`}>
            {p.image && (
              typeof p.image === 'string' ? (
                <img
                  src={p.image}
                  alt={p.title}
                  class="w-full h-full object-cover transition-transform duration-[2000ms] ease-out group-hover:scale-110"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={p.image}
                  alt={p.title}
                  class="w-full h-full object-cover transition-transform duration-[2000ms] ease-out group-hover:scale-110"
                  format="webp"
                  quality={85}
                />
              )
            )}
          </div>

          <!-- Stats & Badges -->
          <div class="absolute top-5 left-5 z-20 flex gap-2">
            {typeof p.views === 'number' && (
              <span class="bg-[#1C2B3A]/60 backdrop-blur-md text-white text-[9px] font-black uppercase px-4 py-1.5 rounded-full flex items-center gap-2">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                {formatViews(p.views)}
              </span>
            )}
            {p.youtubeUrl && (
              <span class="bg-red-500/90 backdrop-blur-md text-white text-[9px] font-black uppercase px-4 py-1.5 rounded-full flex items-center gap-1 shadow-lg">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg> Video
              </span>
            )}
          </div>

          <!-- Gradiente -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#1C2B3A] via-[#1C2B3A]/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-700"></div>

          <!-- Info -->
          <div class="absolute inset-0 p-7 lg:p-10 flex flex-col justify-end pointer-events-none">
            <div class="translate-y-0 lg:translate-y-3 lg:group-hover:translate-y-0 transition-transform duration-500">
              <span class="inline-block text-[9px] font-black uppercase tracking-[0.4em] text-[#C8D9E6] mb-2 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity delay-100">
                Click para ver galería
              </span>
              <h3 class="font-display text-2xl lg:text-3xl font-bold text-white leading-tight mb-3">{p.title}</h3>
              {p.location && (
                <div class="flex items-center gap-2 border-t border-white/20 pt-3 h-auto lg:h-0 lg:opacity-0 lg:group-hover:h-10 lg:group-hover:opacity-100 transition-all duration-500 overflow-hidden uppercase tracking-widest text-[9px] text-white/70">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  {p.location}
                </div>
              )}
            </div>
          </div>
          <div class="absolute inset-0 z-30 cursor-pointer" aria-hidden="true"></div>
        </div>
      ))}
    </div>

    <!-- ── VER TODOS (botón móvil / CTA principal) ── -->
    {hasMore && (
      <div class="mt-14 md:mt-16 flex justify-center">
        <a
          href="/portfolio"
          data-astro-reload
          class="inline-flex items-center gap-4 bg-[#1C2B3A] text-white font-black text-[11px] uppercase tracking-[0.25em] px-10 py-5 rounded-full hover:bg-[#567C8D] transition-all duration-300 hover:scale-105 shadow-xl shadow-[#1C2B3A]/20 group"
        >
          Ver todos los proyectos
          <span class="bg-white/20 text-white text-[10px] font-black px-3 py-1 rounded-full">
            {totalProjects}
          </span>
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M17 8l4 4m0 0l-4 4m4-4H3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    )}

  </div>
</section>

<!-- ── LIGHTBOX MODAL ── -->
<div id="portfolio-modal" class="fixed inset-0 z-[1000] flex items-center justify-center bg-[#1C2B3A] opacity-0 invisible pointer-events-none transition-all duration-500 overflow-hidden" aria-modal="true" role="dialog">

  <div class="absolute inset-0 bg-[#1C2B3A]/95 backdrop-blur-2xl"></div>

  <div class="absolute top-6 left-6 md:top-10 md:left-20 z-[1020] text-white">
    <span id="gallery-counter" class="text-[#C8D9E6] font-display text-2xl md:text-4xl font-black italic block mb-1 md:mb-2 text-shadow-lg">1 / 1</span>
    <h4 id="gallery-title" class="text-[10px] md:text-sm font-bold uppercase tracking-[0.3em] opacity-80">PROYECTO</h4>
  </div>

  <button id="modal-close" aria-label="Cerrar galería" class="absolute top-6 right-6 md:top-10 md:right-20 text-white hover:text-[#C8D9E6] transition-all bg-white/10 hover:bg-white/20 rounded-full p-4 md:p-5 z-[1030] backdrop-blur-md border border-white/10 active:scale-90 shadow-2xl">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button id="prev-btn" class="absolute left-2 md:left-12 top-1/2 -translate-y-1/2 text-white/50 hover:text-white hover:scale-110 transition-all z-[1020] p-4 group">
    <svg class="w-8 h-8 md:w-12 md:h-12 group-active:scale-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
  </button>
  <button id="next-btn" class="absolute right-2 md:right-12 top-1/2 -translate-y-1/2 text-white/50 hover:text-white hover:scale-110 transition-all z-[1020] p-4 group">
    <svg class="w-8 h-8 md:w-12 md:h-12 group-active:scale-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
  </button>

  <div class="relative w-full h-full flex items-center justify-center p-4 md:p-12 z-[1010] pointer-events-none" id="modal-content-wrapper">
    <div id="modal-spinner" class="absolute inset-0 flex items-center justify-center opacity-0 invisible transition-all duration-300 z-[1050] pointer-events-none">
      <div class="flex flex-col items-center gap-6">
        <div class="relative">
          <div class="w-16 h-16 border-4 border-white/10 border-t-white rounded-full animate-spin"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-2 h-2 bg-white rounded-full animate-ping"></div>
          </div>
        </div>
        <div class="text-center">
          <span class="block text-[11px] font-black uppercase tracking-[0.5em] text-white animate-pulse mb-1">Anais Content</span>
          <span class="text-[8px] font-bold uppercase tracking-[0.3em] text-white/40">Cargando Galería...</span>
        </div>
      </div>
    </div>
    <img id="modal-image" src="" alt="Vista previa de galería"
      style="max-width:100%;max-height:85vh;width:auto;height:auto;object-fit:contain;transition:opacity 0.25s ease,transform 0.25s ease;opacity:0;transform:translateX(12px);box-shadow:0 30px 60px rgba(0,0,0,0.9);border-radius:2px;pointer-events:auto;display:none;" />
    
    <video id="modal-video" src="" autoplay loop muted playsinline 
      style="max-width:100%;max-height:85vh;width:auto;height:auto;object-fit:contain;transition:opacity 0.25s ease,transform 0.25s ease;opacity:0;transform:translateX(12px);box-shadow:0 30px 60px rgba(0,0,0,0.9);border-radius:2px;pointer-events:auto;display:none;"></video>
    
    <div id="youtube-overlay" class="absolute inset-0 bg-[#1C2B3A]/90 z-[1060] hidden flex-col items-center justify-center pointer-events-auto backdrop-blur-sm transition-opacity duration-500 opacity-0">
        <h3 class="text-white font-display text-3xl font-bold mb-6 text-center px-4">Continúa viendo en YouTube</h3>
        <a id="youtube-link" href="#" target="_blank" class="bg-red-600 text-white font-black uppercase tracking-widest text-xs px-8 py-4 rounded-full flex items-center gap-3 hover:bg-red-700 hover:scale-105 transition-all shadow-red-600/30 shadow-2xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
            Ver Video Completo
        </a>
    </div>
  </div>
</div>

<script>
import { supabase } from '../lib/supabase';

(function () {
  let gallery = [];
  let idx     = 0;
  let title   = '';
  let keyFn   = null;
  let ytUrl   = '';
  let ytTimer = null;
  
  const getEl = (id) => document.getElementById(id);

  const resetOverlay = () => {
    const overlay = getEl('youtube-overlay');
    if (overlay) {
      overlay.classList.add('hidden', 'opacity-0');
      overlay.classList.remove('flex');
    }
    if (ytTimer) {
      clearTimeout(ytTimer);
      ytTimer = null;
    }
  };

  const setImage = (newIdx) => {
    resetOverlay();
    
    const img = getEl('modal-image');
    const vid = getEl('modal-video');
    if (!img || !vid || !gallery.length) return;
    
    idx = (newIdx + gallery.length) % gallery.length;
    const currentUrl = gallery[idx];
    const isVideo = currentUrl.match(/\.(mp4|webm|ogg)$/i);

    img.style.opacity = '0';
    img.style.transform = 'translateX(12px)';
    vid.style.opacity = '0';
    vid.style.transform = 'translateX(12px)';
    
    img.style.display = isVideo ? 'none' : 'block';
    vid.style.display = isVideo ? 'block' : 'none';

    // Preload next image if not video
    const nextIdx = (idx + 1) % gallery.length;
    if (!gallery[nextIdx].match(/\.(mp4|webm|ogg)$/i)) {
        new Image().src = gallery[nextIdx];
    }

    const counter = getEl('gallery-counter');
    const titleEl = getEl('gallery-title');
    if (counter) counter.textContent = `${idx + 1} / ${gallery.length}`;
    if (titleEl)  titleEl.textContent  = title;

    const spinner = getEl('modal-spinner');
    
    const showTarget = (target) => {
      target.style.opacity   = '1';
      target.style.transform = 'translateX(0)';
      if (spinner) spinner.classList.add('opacity-0', 'invisible');
      
      // Youtube 5s redirect logic
      if (ytUrl) {
          ytTimer = setTimeout(() => {
              if (isVideo) vid.pause();
              const overlay = getEl('youtube-overlay');
              if (overlay) {
                  getEl('youtube-link').href = ytUrl;
                  overlay.classList.remove('hidden');
                  overlay.classList.add('flex');
                  setTimeout(() => overlay.classList.remove('opacity-0'), 50);
              }
          }, 5000);
      }
    };

    if (isVideo) {
      vid.src = currentUrl;
      vid.onloadeddata = () => showTarget(vid);
      vid.onerror = () => { if (spinner) spinner.classList.add('opacity-0', 'invisible'); };
    } else {
      img.onload  = () => showTarget(img);
      img.onerror = () => { if (spinner) spinner.classList.add('opacity-0', 'invisible'); };
      img.src = currentUrl;
      if (img.complete && img.naturalWidth) showTarget(img);
      else if (spinner) spinner.classList.remove('opacity-0', 'invisible');
    }
  };

  const openModal = async (galleryJson, projectTitle, youtubeUrl, projectId) => {
    try {
      gallery = JSON.parse(galleryJson || '[]');
      title   = projectTitle || '';
      ytUrl   = youtubeUrl || '';
      
      if (!gallery.length) return;
      const modal = getEl('portfolio-modal');
      if (!modal) return;
      modal.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
      document.body.style.overflow = 'hidden';
      setImage(0);
      
      if (projectId) {
          // Increment views silently
          const pId = parseInt(projectId, 10);
          if (!isNaN(pId)) {
              await supabase.rpc('increment_views', { project_id: pId });
          }
      }
    } catch (e) { console.error('Gallery open error', e); }
  };

  const closeModal = () => {
    resetOverlay();
    const modal = getEl('portfolio-modal');
    const img   = getEl('modal-image');
    const vid   = getEl('modal-video');
    if (!modal) return;
    modal.classList.add('opacity-0', 'pointer-events-none', 'invisible');
    document.body.style.overflow = '';
    if (img) {
      img.style.opacity   = '0';
      img.style.transform = 'translateX(12px)';
      img.src = '';
      img.onload = null;
    }
    if (vid) {
      vid.style.opacity = '0';
      vid.style.transform = 'translateX(12px)';
      vid.pause();
      vid.src = '';
    }
  };

  const init = () => {
    const modal    = getEl('portfolio-modal');
    const closeBtn = getEl('modal-close');
    const prevBtn  = getEl('prev-btn');
    const nextBtn  = getEl('next-btn');
    if (!modal) return;

    document.querySelectorAll('.portfolio-item').forEach(item => {
      item.onclick = () =>
        openModal(
            item.getAttribute('data-gallery'), 
            item.getAttribute('data-title'),
            item.getAttribute('data-youtube'),
            item.getAttribute('data-id')
        );
    });

    if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); closeModal(); };
    if (prevBtn)  prevBtn.onclick  = (e) => { e.stopPropagation(); setImage(idx - 1); };
    if (nextBtn)  nextBtn.onclick  = (e) => { e.stopPropagation(); setImage(idx + 1); };

    modal.onclick = (e) => {
      if (e.target === modal || e.target.id === 'modal-content-wrapper') closeModal();
    };

    if (keyFn) window.removeEventListener('keydown', keyFn);
    keyFn = (e) => {
      if (modal.classList.contains('pointer-events-none')) return;
      if (e.key === 'Escape')     closeModal();
      if (e.key === 'ArrowRight') setImage(idx + 1);
      if (e.key === 'ArrowLeft')  setImage(idx - 1);
    };
    window.addEventListener('keydown', keyFn);
  };

  init();
  document.addEventListener('astro:page-load',  init);
  document.addEventListener('astro:after-swap', init);
})();
</script>

<style>
  .text-shadow-lg { text-shadow: 0 4px 12px rgba(0,0,0,0.5); }
</style>