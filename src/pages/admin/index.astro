---
// Force refresh: 2026-03-14 01:30
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Acceso Admin">
  <main class="min-h-screen bg-[#F5EFEB] flex items-center justify-center px-6">
    <div class="max-w-md w-full bg-white p-12 rounded-[40px] shadow-2xl border border-white/50">
      <div class="text-center mb-10">
        <h1 class="font-display text-4xl font-bold text-[#1C2B3A] mb-2">Panel Administrativo</h1>
        <p class="text-xs text-[#567C8D] uppercase tracking-widest font-bold">Inicia sesión para editar el contenido</p>
      </div>
      
      <form id="login-form" class="space-y-6">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-[#567C8D] mb-3">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            required 
            class="w-full bg-[#F5EFEB] border-none rounded-2xl px-6 py-4 text-[#1C2B3A] focus:ring-2 focus:ring-[#567C8D] transition-all"
            placeholder="Introduce tu correo"
          />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-[#567C8D] mb-3">Contraseña de Acceso</label>
          <input 
            type="password" 
            id="password" 
            required 
            class="w-full bg-[#F5EFEB] border-none rounded-2xl px-6 py-4 text-[#1C2B3A] focus:ring-2 focus:ring-[#567C8D] transition-all"
            placeholder="••••••••"
          />
          <div class="flex justify-end mt-2">
            <button type="button" id="forgot-password-btn" class="text-[10px] font-bold text-[#567C8D] hover:text-[#1C2B3A] transition-colors uppercase tracking-wider">
              ¿Olvidaste tu contraseña?
            </button>
          </div>
        </div>
        
        <button 
          type="submit" 
          class="w-full bg-[#1C2B3A] text-white py-5 rounded-2xl font-bold uppercase tracking-[0.2em] text-[11px] shadow-xl hover:bg-[#567C8D] transition-all transform active:scale-95"
        >
          Entrar al Panel
        </button>
        <p id="error-msg" class="text-xs text-red-500 font-bold text-center h-4"></p>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  const form = document.getElementById('login-form');
  const errorMsg = document.getElementById('error-msg');
  const forgotPasswordBtn = document.getElementById('forgot-password-btn');
  
  // Login standard
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const emailInput = (document.getElementById('email') as HTMLInputElement).value;
    const passInput = (document.getElementById('password') as HTMLInputElement).value;
    
    if (errorMsg) {
      errorMsg.innerText = 'Validando...';
      errorMsg.className = 'text-xs text-[#567C8D] font-bold text-center h-4';
    }

    const { data, error } = await supabase.auth.signInWithPassword({
      email: emailInput,
      password: passInput,
    });

    if (!error && data.user) {
      sessionStorage.setItem('admin_access', 'true');
      window.location.href = '/admin/dashboard';
    } else {
      if (errorMsg) {
        errorMsg.innerText = 'Correo o contraseña incorrectos';
        errorMsg.className = 'text-xs text-red-500 font-bold text-center h-4';
      }
    }
  });

  // Recuperar contraseña
  forgotPasswordBtn?.addEventListener('click', async () => {
    const emailInput = (document.getElementById('email') as HTMLInputElement).value;
    
    if (!emailInput) {
      if (errorMsg) {
        errorMsg.innerText = 'Por favor ingresa tu correo primero';
        errorMsg.className = 'text-xs text-amber-500 font-bold text-center h-4';
      }
      return;
    }

    if (errorMsg) {
      errorMsg.innerText = 'Enviando correo de recuperación...';
      errorMsg.className = 'text-xs text-[#567C8D] font-bold text-center h-4';
    }

    const { error } = await supabase.auth.resetPasswordForEmail(emailInput, {
      redirectTo: window.location.origin + '/admin/security',
    });

    if (error) {
      if (errorMsg) {
        errorMsg.innerText = 'Error al enviar correo: ' + error.message;
        errorMsg.className = 'text-xs text-red-500 font-bold text-center h-4';
      }
    } else {
      if (errorMsg) {
        errorMsg.innerText = '¡Correo enviado! Revisa tu bandeja de entrada o spam.';
        errorMsg.className = 'text-xs text-emerald-500 font-bold text-center h-4';
      }
    }
  });
</script>
